*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth;scroll-padding-top:80px}:root{--bg-deep:#0a0a1a;--bg-card:#141428;--bg-glass:#1414288c;--neon-pink:#ff006e;--neon-orange:#fb5607;--neon-cyan:#00f5d4;--neon-purple:#9d4edd;--neon-blue:#3a86ff;--text-primary:#f0e6ff;--text-muted:#9b8ab3;--text-dim:#5a4e72;--gradient-main:linear-gradient(135deg,#ff006e,#fb5607);--gradient-dark:linear-gradient(180deg,#0a0a1a,#1a1a3a)}body{background:var(--bg-deep);color:var(--text-primary);min-height:100vh;font-family:Segoe UI,-apple-system,BlinkMacSystemFont,sans-serif;overflow-x:hidden}body:before{content:"";z-index:-1;background:radial-gradient(at 20% 20%,#ff006e26 0,#0000 50%),radial-gradient(at 80% 80%,#3a86ff1f 0,#0000 50%),radial-gradient(#9d4edd14 0,#0000 60%);animation:20s ease-in-out infinite alternate bgshift;position:fixed;inset:0}@keyframes bgshift{0%{filter:hue-rotate()brightness()}to{filter:hue-rotate(30deg)brightness(1.1)}}a{color:inherit;text-decoration:none}button,input,select{font:inherit}button{cursor:pointer;color:inherit;background:0 0;border:none}.site-header{z-index:100;-webkit-backdrop-filter:blur(18px)saturate(180%);background:#0a0a1ab3;border-bottom:1px solid #ff006e26;align-items:center;gap:32px;padding:14px max(6vw,22px);display:flex;position:sticky;top:0}.brand{letter-spacing:-1px;background:var(--gradient-main);-webkit-text-fill-color:transparent;-webkit-background-clip:text;background-clip:text;font-size:22px;font-weight:900}.brand span{color:var(--neon-cyan);-webkit-text-fill-color:var(--neon-cyan)}.site-header nav{gap:22px;font-size:13px;display:flex}.site-header nav a{color:var(--text-muted);transition:color .25s}.site-header nav a:hover{color:var(--neon-pink);text-shadow:0 0 10px #ff006e99}.lab-label{letter-spacing:2.5px;color:var(--text-dim);text-transform:uppercase;margin-left:auto;font-size:9px}.hero{padding:80px max(6vw,22px) 60px;position:relative}.eyebrow{letter-spacing:3px;text-transform:uppercase;color:var(--neon-pink);text-shadow:0 0 14px #ff006e80;font-size:10px;font-weight:700}.hero h1{letter-spacing:-3px;background:linear-gradient(120deg,#fff 20%,#ff006e 50%,#fb5607 80%);-webkit-text-fill-color:transparent;background-size:200%;-webkit-background-clip:text;background-clip:text;margin:18px 0 22px;font-size:clamp(42px,6vw,80px);font-weight:900;line-height:.95;animation:5s linear infinite gradtext}@keyframes gradtext{0%{background-position:0%}to{background-position:200%}}.hero>p:not(.eyebrow){color:var(--text-muted);max-width:560px;font-size:16px;line-height:1.7}.key-form{max-width:560px;margin-top:32px}.key-form>label{color:var(--text-muted);letter-spacing:1px;margin-bottom:10px;font-size:12px;display:block}.key-help{color:var(--text-dim);margin-top:10px;font-size:11px}.key-help a{color:var(--neon-cyan);transition:color .2s}.key-help a:hover{color:var(--neon-pink)}.search-form{max-width:680px;margin-top:32px}.search-form>label{color:var(--text-muted);letter-spacing:1px;text-transform:uppercase;margin-bottom:10px;font-size:11px;display:block}.search-field{background:#141428b3;border:1.5px solid #ff006e4d;border-radius:100px;align-items:center;gap:6px;padding:4px 4px 4px 20px;transition:all .3s;display:flex}.search-field:focus-within{border-color:var(--neon-pink);box-shadow:0 0 22px #ff006e4d,inset 0 0 18px #ff006e14}.search-field input{min-width:0;color:var(--text-primary);background:0 0;border:none;outline:none;flex:1;padding:10px 4px;font-size:15px}.search-field input::placeholder{color:var(--text-dim)}button[type=submit]{background:var(--gradient-main);color:#fff;letter-spacing:1px;text-transform:uppercase;border-radius:100px;padding:11px 26px;font-size:13px;font-weight:800;transition:transform .2s,box-shadow .2s}button[type=submit]:hover:not(:disabled){transform:scale(1.05);box-shadow:0 0 20px #ff006e80}button:disabled{opacity:.35;cursor:not-allowed}.connection-actions{flex-wrap:wrap;gap:10px;margin-top:18px;display:flex}.connection-actions button{letter-spacing:1.5px;text-transform:uppercase;color:var(--neon-cyan);border:1px solid #00f5d44d;border-radius:100px;padding:9px 18px;font-size:11px;transition:all .25s}.connection-actions button:hover:not(:disabled){border-color:var(--neon-cyan);background:#00f5d414;box-shadow:0 0 12px #00f5d44d}.trending-strip{border-top:1px solid #ff006e1a;border-bottom:1px solid #ff006e1a;margin-top:48px;padding:16px 0}.trending-strip h3{letter-spacing:3px;text-transform:uppercase;color:var(--text-muted);align-items:center;gap:10px;margin-bottom:14px;font-size:11px;display:flex}.trending-strip h3:before{content:"🔥";font-size:14px}.trending-scroll{scroll-snap-type:x mandatory;gap:14px;padding:6px 2px 14px;display:flex;overflow-x:auto}.trending-scroll::-webkit-scrollbar{height:6px}.trending-scroll::-webkit-scrollbar-thumb{background:var(--neon-pink);border-radius:3px}.trending-scroll::-webkit-scrollbar-track{background:#ffffff0d}.trending-item{scroll-snap-align:start;border-radius:10px;flex:none;width:140px;transition:transform .3s,box-shadow .3s;overflow:hidden}.trending-item:hover{transform:translateY(-6px);box-shadow:0 0 25px #ff006e80}.trending-item img{object-fit:cover;border-radius:10px;width:140px;height:200px;display:block}.trending-item small{color:var(--text-muted);text-overflow:ellipsis;white-space:nowrap;margin-top:6px;font-size:11px;display:block;overflow:hidden}.catalog{padding:50px max(6vw,22px) 70px}.section-heading{justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:32px;display:flex}.section-heading .eyebrow{color:var(--neon-cyan)}.section-heading h2{letter-spacing:-1.5px;margin-top:6px;font-size:clamp(24px,3vw,36px);font-weight:800}.result-count{color:var(--text-dim);letter-spacing:1px;text-transform:uppercase;text-align:right;font-size:11px}.movie-grid{grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:26px;display:grid}@media (width>=1500px){.movie-grid{grid-template-columns:repeat(6,minmax(0,1fr))}}@media (width<=700px){.movie-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 14px}}.movie-card{background:var(--bg-card);cursor:pointer;border:1px solid #ff006e1a;border-radius:14px;transition:transform .35s,box-shadow .35s,border-color .35s;overflow:hidden}.movie-card:hover{border-color:var(--neon-pink);transform:translateY(-8px)scale(1.02);box-shadow:0 12px 40px #ff006e40,0 0 30px #ff006e1a}.movie-poster,.poster-fallback{aspect-ratio:2/3;object-fit:cover;background:#1a1a2e;width:100%;transition:filter .3s;display:block}.movie-card:hover .movie-poster{filter:brightness(1.1)saturate(1.2)}.poster-fallback{color:var(--text-muted);text-align:center;background:linear-gradient(155deg,#1a1a2e,#0f0f1e);flex-direction:column;justify-content:center;align-items:center;gap:14px;padding:20px;display:flex}.poster-fallback span{letter-spacing:2px;text-transform:uppercase;color:var(--text-dim);font-size:11px}.poster-fallback strong{color:var(--text-primary);font-size:18px;line-height:1.3}.movie-info{padding:16px 18px 20px;position:relative}.rating{background:var(--bg-card);border:2px solid var(--neon-pink);width:48px;height:48px;color:var(--neon-pink);border-radius:50%;flex-direction:column;justify-content:center;align-items:center;font-size:14px;font-weight:900;display:flex;position:absolute;top:-22px;right:14px;box-shadow:0 0 14px #ff006e66}.rating small{color:var(--text-dim);margin-top:1px;font-size:7px;font-weight:400}.genre{letter-spacing:2px;text-transform:uppercase;color:var(--neon-cyan);margin-right:60px;font-size:9px}.movie-info h3{letter-spacing:-.3px;margin:6px 0 4px;font-size:15px;font-weight:700;line-height:1.3}.movie-info h3 a{color:var(--text-primary);transition:color .2s}.movie-info h3 a:hover{color:var(--neon-pink)}.movie-info time{color:var(--text-dim);font-size:11px}.overview{color:var(--text-muted);-webkit-line-clamp:2;-webkit-box-orient:vertical;margin:8px 0 0;font-size:12px;line-height:1.55;display:-webkit-box;overflow:hidden}.unknown-date{color:var(--text-dim);font-size:11px}.status-box{text-align:center;background:#14142899;border:1px solid #9d4edd4d;border-radius:14px;margin-top:24px;padding:50px 28px}.status-box.error{color:#ff8a8a;border-color:#ef444466}.status-box.error h3{color:#ff6b6b}.empty-state{text-align:center;background:#14142880;border:1px dashed #ff006e40;border-radius:14px;margin-top:24px;padding:60px 20px}.empty-state h3{background:var(--gradient-main);-webkit-text-fill-color:transparent;-webkit-background-clip:text;background-clip:text;margin-bottom:8px;font-size:22px}.empty-state p{color:var(--text-muted);margin-bottom:16px}.empty-state button{background:var(--gradient-main);color:#fff;letter-spacing:1.5px;text-transform:uppercase;border-radius:100px;padding:10px 22px;font-size:12px;font-weight:700;transition:transform .2s}.empty-state button:hover{transform:scale(1.05)}.pagination{border-top:1px solid #ff006e1a;justify-content:center;align-items:center;gap:14px;margin-top:48px;padding-top:32px;display:flex}.pagination button{color:var(--neon-cyan);letter-spacing:1px;text-transform:uppercase;border:1px solid #00f5d44d;border-radius:100px;padding:10px 18px;font-size:13px;font-weight:700;transition:all .2s}.pagination button:hover:not(:disabled){border-color:var(--neon-cyan);background:#00f5d414;box-shadow:0 0 14px #00f5d44d}.pagination span{color:var(--text-muted);letter-spacing:1px;padding:0 8px;font-size:11px}.movie-modal-backdrop{z-index:200;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);background:#000000d9;justify-content:center;align-items:center;padding:20px;animation:.25s fadein;display:flex;position:fixed;inset:0}@keyframes fadein{0%{opacity:0}to{opacity:1}}.movie-modal{background:var(--bg-card);border:1px solid #ff006e4d;border-radius:18px;width:100%;max-width:520px;max-height:85vh;animation:.3s slideup;position:relative;overflow-y:auto}@keyframes slideup{0%{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}.movie-modal-close{z-index:10;color:#fff;background:#0009;border-radius:50%;width:36px;height:36px;font-size:18px;font-weight:700;transition:background .2s;position:absolute;top:14px;right:14px}.movie-modal-close:hover{background:var(--neon-pink)}.movie-modal-poster{aspect-ratio:2/3;object-fit:cover;border-radius:18px 18px 0 0;width:100%}.movie-modal-info{padding:24px 28px 32px}.movie-modal-info h2{letter-spacing:-.5px;margin-bottom:6px;font-size:24px;font-weight:800}.movie-modal-meta{color:var(--text-muted);gap:12px;margin-bottom:14px;font-size:12px;display:flex}.movie-modal-meta .rating-badge{background:var(--neon-pink);color:#fff;border-radius:100px;padding:3px 10px;font-size:12px;font-weight:800}.movie-modal-info p.overview{-webkit-line-clamp:unset;color:var(--text-muted);margin-top:12px;font-size:14px;line-height:1.7;display:block;overflow:visible}.movie-modal-info a.tmdb-link{color:var(--neon-cyan);letter-spacing:1.5px;text-transform:uppercase;border:1px solid var(--neon-cyan);border-radius:100px;margin-top:16px;padding:8px 18px;font-size:12px;transition:all .2s;display:inline-block}.movie-modal-info a.tmdb-link:hover{background:#00f5d41a}.site-footer{text-align:center;border-top:1px solid #ff006e1a;padding:40px max(6vw,22px)}.site-footer strong{letter-spacing:3px;text-transform:uppercase;color:var(--text-dim);margin-bottom:14px;font-size:11px;display:block}.tmdb-credit{margin-bottom:12px;display:inline-block}.tmdb-credit img{filter:brightness(0)invert(.7);width:auto;height:36px}.site-footer p{color:var(--text-dim);max-width:680px;margin:4px auto;font-size:11px;line-height:1.8}@media (width<=700px){.site-header{gap:14px;padding:12px 16px}.lab-label{display:none}.site-header nav{gap:14px;font-size:12px}.hero{padding:50px 20px 40px}.hero h1{font-size:clamp(32px,9vw,48px)}.trending-scroll{align-items:flex-start}.trending-item{width:110px}.trending-item img{width:110px;height:157px}.movie-grid{grid-template-columns:repeat(2,1fr);gap:18px 12px}.rating{width:40px;height:40px;font-size:12px}.movie-info h3{font-size:14px}.pagination span{font-size:10px}}
